{
  "$comment": "Native bridge contract implemented by both mobile builds. The shared renderer uses the desktop-shaped adapter in renderer/mobile-bridge.js, which maps this contract to window.downloader.",
  "version": 2,
  "methods": {
    "snapshot": { "request": {}, "response": { "ok": true, "downloads": "Download[]", "settings": "Settings", "integration": "Integration" } },
    "status": { "request": {}, "response": { "ok": true, "items": "Download[]", "settings": "Settings" } },
    "add": { "request": { "urls": "string[]", "url": "string?", "mirrors": "string[]?", "filename": "string?", "checksum": "sha256:<64 hex>|md5:<32 hex>?", "category": "string?", "description": "string?", "scheduledAt": "ISO-8601?", "directory": "string?", "extract": "boolean?", "extractFormat": "string?", "outputFormat": "string?", "queueOnly": "boolean?" }, "response": { "ok": true, "value": "string[]" } },
    "downloads": { "request": {}, "response": { "ok": true, "value": "string[]" } },
    "control": { "request": { "id": "uuid", "action": "pause|resume|retry|cancel|remove|open|reveal|start|stop" }, "response": { "ok": true, "value": true } },
    "action": { "request": {}, "response": { "ok": true, "value": true } },
    "formats": { "request": { "url": "page URL" }, "response": { "ok": true, "value": "FormatChoice[]" } },
    "review": { "request": { "id": "uuid", "filename": "string?", "extractFormat": "string?" }, "response": { "ok": true, "value": "string[]" } },
    "settings": { "request": "Settings (partial)", "response": { "ok": true, "value": "Settings" } },
    "clipboard": { "request": {}, "response": { "ok": true, "value": "string" } },
    "chooseDirectory": { "request": {}, "response": { "ok": true, "value": "app output path" } },
    "integration": { "request": {}, "response": { "ok": true, "value": { "browsers": [], "connectionError": "string" } } },
    "browserSetup": { "request": {}, "response": { "ok": true, "value": "string" } },
    "openProgress": { "request": {}, "response": { "ok": true, "value": true } },
    "about": { "request": {}, "response": { "ok": true, "value": true } }
  },
  "errors": { "shape": { "ok": false, "error": "string (no URLs, cookies or headers)" }, "maxLength": 700 },
  "limits": { "messageBytes": 1048576, "maxConcurrent": "setting (default 4)", "connectionsPerDownload": "setting (default 16)", "blockSize": 2097152, "checksumAlgorithms": ["md5", "sha256"] }
}
